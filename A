  }
  const tile=(lab,k,id,act,mn)=>`<div class="rt ${act?'act':''}"><small>${lab}</small>${k?`<b>${fmt(k,{day:'numeric'})}</b><span>${fmt(k,{weekday:'short',month:'short',year:'numeric'})}</span>`:`<b>–</b><span>Select a date</span>`}<input id="${id}" type="date" ${mn?`min="${mn}"`:''} value="${k||''}" aria-label="${lab} date"></div>`;
  const dn=sel.s&&sel.e?days(sel.s,sel.e):0,sm=sel.s&&sel.e?`<em>${dn+1} ${dn?'days':'day'} · ${dn} ${dn===1?'night':'nights'}</em>`:sel.s?'Now choose your last day':'Choose your first day';
  const r=`<div class="rng"><div class="rg">${tile('From',sel.s,'rf',!sel.s,minDate)}<div class="rmid">${I('chev',20)}</div>${tile('To',sel.e,'ru',!!sel.s&&!sel.e,sel.s||minDate)}</div><div class="rsum">${sm}</div></div>`;
  return hd('Trips',editId?'Modify trip':'Plan a new trip')+
  (editId?`<div class="edit-banner"><span>Editing: ${esc(fd.n||'Holiday')}</span><button class="btn soft sm" data-a="cancelEdit" style="padding:5px 12px">Cancel</button></div>`:'')+
  r+
  `<div class="cal"><div class="ch"><button data-a="mo" data-v="-1" aria-label="Previous month">‹</button><h3>${f.toLocaleDateString(undefined,{month:'long',year:'numeric'})}</h3><button data-a="mo" data-v="1" aria-label="Next month">›</button></div><div class="grid">${c}</div><p class="sub" style="margin-top:12px">Tap your first day, then your last day. Gold dots mark days you’re already away.</p></div>`+
  `<div class="list"><label class="f"><span>Holiday name</span><input id="tn" placeholder="Summer in Lisbon" value="${esc(fd.n)}"></label><label class="f"><span>Destination</span><input id="td" placeholder="Lisbon, Portugal" value="${esc(fd.d)}"></label><label class="f"><span>Holiday type</span><select id="tt">${Object.keys(TYPES).map(k=>`<option ${fd.t===k?'selected':''}>${k}</option>`).join('')}</select></label>${editId?'':`<label class="f"><span>Remind me to pack</span><select id="tr">${[['','No reminder'],['1','1 day before'],['3','3 days before'],['7','1 week before']].map(([v,l])=>`<option value="${v}" ${fd.r===v?'selected':''}>${l}</option>`).join('')}</select></label>`}</div>`+
  (editId?`<div class="btn-row"><button class="btn soft" data-a="cancelEdit">Cancel</button><button class="btn" data-a="saveTrip">Save changes</button></div>`:`<button class="btn" data-a="saveTrip">Save trip</button>`)+
  (up.length?`<h2>Upcoming trips</h2>`+holList(up):'');
}

function packCard(t){
  const pk=D.pack[t.id]||[],dn=pk.filter(i=>i.done).length,lf=pk.filter(i=>!i.done),il=lf.filter(i=>i.imp).length,p=pk.length?dn/pk.length*100:0,dd=days(today,t.start),when=today>=t.start?'Happening now':dd===0?'Starts today':dd===1?'Starts tomorrow':'In '+dd+' days',all=pk.length>0&&!lf.length;
  return `<div class="pc ${all?'ok':''}"><button class="pch" data-a="pick" data-v="${t.id}"><span class="t"><b>${esc(t.name)}</b><span class="sub">${esc(t.dest||'')}${t.dest?' · ':''}${fmt(t.start)} to ${fmt(t.end)} · ${when}</span></span>${I('chev')}</button>`+
  (pk.length?`<div class="pcs"><span><b>${dn}</b> of <b>${pk.length}</b> packed</span>${all?'<span style="color:var(--acc);font-weight:700">All packed ✓</span>':il?`<span class="rd">${il} important left</span>`:`<span>${lf.length} left</span>`}</div><div class="pbar"><i style="width:${p}%"></i></div>`:`<div class="pcs"><span>Nothing in the bag yet</span></div>`)+
  `<div class="pca"><button class="btn soft sm" data-a="addTo" data-v="${t.id}">${I('plus',14)} Add item</button><button class="btn soft sm" data-a="openT" data-v="${t.id}">${I('cal',14)} Schedule</button></div></div>`;
}

function vPack(){
  const t=pv&&D.trips.find(x=>x.id===pv);
  if(!t){
    const up=upcoming();
    return hd('Packing','Trip by trip')+(up.length?up.map(packCard).join('')+`<p class="note">Tap a trip to see its full list.</p>`:`<div class="list empty"><b>Add a trip first</b>Your packing list belongs to a trip.<br><br><button class="btn sm" data-a="tab" data-v="cal" style="margin:auto">Add a trip</button></div>`);
  }
  const pk=D.pack[t.id]||[],dn=pk.filter(i=>i.done).length,p=pk.length?Math.round(dn/pk.length*100):0,sg=sugs(t),ilf=pk.filter(i=>i.imp&&!i.done).length;
  const filtered=pk.filter(i=>{
    if(pkFilter==='left'&&i.done)return false;
    if(pkFilter==='imp'&&!i.imp)return false;
    if(pkSearch&&!i.t.toLowerCase().includes(pkSearch.toLowerCase())&&!i.c.toLowerCase().includes(pkSearch.toLowerCase()))return false;
    return true;
  });
  const row=i=>`<div class="li ${i.imp?'imp':''} ${i.done?'done':''}"><button class="ck" data-a="chk" data-v="${t.id}|${i.id}" aria-label="Toggle ${esc(i.t)}">${I('check',15)}</button><span class="t">${esc(i.t)}${i.imp?'<em class="im">Important</em>':''}</span><div class="qty"><button data-a="qty" data-v="${i.id}|-1">−</button><span>${i.q||1}×</span><button data-a="qty" data-v="${i.id}|1">+</button></div><button class="x" data-a="star" data-v="${i.id}" aria-label="Mark important" style="${i.imp?'color:var(--red)':''}">${I('star',16)}</button><button class="x" data-a="delItem" data-v="${i.id}" aria-label="Remove">${I('x',16)}</button></div>`;
  const grp=arr=>CATS.map(c=>{const it=arr.filter(i=>i.c===c);return it.length?`<div class="cat">${c}</div>`+it.map(row).join(''):''}).join('');
  const im=filtered.filter(i=>i.imp),ot=filtered.filter(i=>!i.imp);
  return hd('Packing',esc(t.name)+(t.type?' · '+esc(t.type):''))+
