  dl:'<path d="M12 3v12m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/>'
};
const I=(n,s=22)=>`<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${P[n]||P.sun}</svg>`;

let fd={n:"",d:"",t:"",r:"1"},editId=null,pv=null,impV=false,pkFilter='all',pkSearch='';
let D={trips:[],pack:{},rem:[],mem:[],active:null},tab='home',memF='all',ti=0,slI=0,curT=null,sel={s:null,e:null},cm={y:new Date().getFullYear(),m:new Date().getMonth()};
try{Object.assign(D,JSON.parse(LS.g('wf_data')||'{}'))}catch(e){}

const CATS=['Documents','Clothes','Tech','Health','Misc'];
const TYPES={
  Beach:{s:[['Clothes','Swimwear'],['Clothes','Sandals'],['Clothes','Sun hat'],['Misc','Beach towel'],['Misc','Sunglasses'],['Health','After-sun lotion']]},
  City:{s:[['Clothes','Walking shoes'],['Tech','Power bank'],['Misc','Day backpack'],['Documents','Maps and city pass'],['Misc','Reusable bag']]},
  Mountain:{s:[['Clothes','Hiking boots'],['Clothes','Warm layers'],['Clothes','Rain jacket'],['Health','First aid kit'],['Tech','Torch'],['Misc','Daypack']]},
  'Road trip':{s:[['Documents','Driving licence'],['Tech','Car charger'],['Misc','Snacks'],['Misc','Playlist and headphones'],['Tech','Offline maps'],['Misc','Blanket']]},
  Business:{s:[['Clothes','Formal outfits'],['Tech','Laptop and charger'],['Documents','Business cards'],['Misc','Notebook and pen'],['Clothes','Dress shoes']]},
  Winter:{s:[['Clothes','Warm coat'],['Clothes','Gloves and scarf'],['Clothes','Thermal layers'],['Health','Lip balm'],['Clothes','Waterproof boots']]}
};
const ESS=[['Documents','Passport or ID'],['Documents','Tickets and bookings'],['Documents','Travel insurance'],['Clothes','Underwear and socks'],['Clothes','Comfortable shoes'],['Clothes','Light jacket'],['Tech','Phone charger'],['Tech','Power adapter'],['Health','Medication'],['Health','Sunscreen'],['Misc','Cash and cards'],['Misc','Water bottle']];

const isImp=(c,n)=>c==='Documents'||n==='Medication';
const addD=(s,n)=>{const d=pd(s);d.setDate(d.getDate()+n);return iso(d)};
const sugs=t=>{const tp=(TYPES[t.type]||{s:[]}).s,pk=D.pack[t.id]||[];return[...tp,...ESS].filter(([c,n])=>!pk.some(i=>i.t===n))};
const upcoming=()=>D.trips.filter(t=>t.end>=today).sort((a,b)=>a.start.localeCompare(b.start)),past=()=>D.trips.filter(t=>t.end<today).sort((a,b)=>b.end.localeCompare(a.end)),trip=()=>D.trips.find(t=>t.id===D.active)||upcoming()[0]||D.trips[0];
const byImp=a=>a.slice().sort((x,y)=>(y.imp?1:0)-(x.imp?1:0));

const remRow=x=>`<div class="li ${x.done?'done':''}"><button class="ck" data-a="remDone" data-v="${x.id}" aria-label="Mark done">${I('check',15)}</button><div class="t"><b>${esc(x.text)}</b><span class="sub">${fmt(x.date,{weekday:'short',day:'numeric',month:'short'})} at ${x.time}</span></div><button class="x" data-a="delRem" data-v="${x.id}" aria-label="Delete">${I('x',16)}</button></div>`;

function holList(list){
  if(!list.length)return '';
  const row=x=>{
    const pk=D.pack[x.id]||[],lf=pk.filter(i=>!i.done),il=lf.filter(i=>i.imp).length,nm=byImp(lf).slice(0,3).map(i=>esc(i.t)).join(', ')+(lf.length>3?' +'+(lf.length-3)+' more':'');
    return `<div class="li"><button class="li" style="padding:0;border:0" data-a="pick" data-v="${x.id}"><span class="ico">${I('sun')}</span><div class="t"><b>${esc(x.name)}</b><span class="sub">${esc(x.dest||'')}${x.dest?' · ':''}${fmt(x.start)} to ${fmt(x.end)}${x.type?' · '+esc(x.type):''}</span><span class="left">${!pk.length?'No packing list yet':lf.length?`<b>${lf.length} left to pack</b>${il?` · <span class="rd">${il} important</span>`:''}: ${nm}`:'<span style="color:var(--acc);font-weight:600">All packed</span>'}</span></div></button><button class="x" data-a="openT" data-v="${x.id}" title="Schedule & Hub" aria-label="Trip schedule">${I('map',16)}</button><button class="x" data-a="editTrip" data-v="${x.id}" title="Modify trip" aria-label="Modify holiday">${I('edit',16)}</button><button class="x" data-a="delTrip" data-v="${x.id}" aria-label="Delete holiday">${I('x',16)}</button></div>`;
  };
  return `<div class="list">${list.map(row).join('')}</div>`;
}

const STEPS=[
  ['sun','Welcome to Wayfare','Plan a holiday from first idea to last photo. There’s no account to create. Everything is saved privately on this device.'],
  ['cal','Add or modify a trip','Open Trips and choose your From and To dates, or tap them on the calendar. Name the holiday, choose its type and a reminder, then save it. Tap the edit icon on any trip to modify it.'],
  ['bag','Pack with confidence','Each trip has its own list with quantities and search. Important things show in red so you never forget them. Tick things off and watch your progress ring fill.'],
  ['bell','Never miss a moment','Reminders are grouped by trip, with what is still left to pack right underneath.'],
  ['img','Trips become memories','Tap Schedule on any trip or open it in Memories to view its day-by-day plan, booking references, things you took, pictures and notes.']
];

const save=()=>{if(!LS.s('wf_data',JSON.stringify(D))){toast('Storage is full. Remove a few photos.');return false}return true};
function applyTheme(){const t=LS.g('wf_theme')||'auto',r=document.documentElement;t==='auto'?delete r.dataset.theme:r.dataset.theme=t}applyTheme();
let tt;function toast(m){clearTimeout(tt);document.querySelectorAll('.toast').forEach(e=>e.remove());const d=document.createElement('div');d.className='toast';d.setAttribute('role','status');d.textContent=m;document.body.appendChild(d);tt=setTimeout(()=>d.remove(),3200)}
function sheet(h){closeSheet();const o=document.createElement('div');o.className='ov';o.id='ov';o.innerHTML='<div class="sheet">'+h+'</div>';o.onclick=e=>{if(e.target===o)closeSheet()};document.body.appendChild(o)}
const closeSheet=()=>{const o=$('#ov');o&&o.remove()};
const NAV=[['home','home','Home'],['cal','cal','Trips'],['pack','bag','Packing'],['rem','bell','Reminders'],['mem','img','Memories']];

function upd(t){
  const car=t.classList.contains('car'),k=car&&t.firstElementChild?t.firstElementChild.offsetWidth+12:t.clientWidth,i=Math.max(0,Math.round(t.scrollLeft/(k||1)));
  if(!car)slI=i;
  const d=t.nextElementSibling;if(d&&d.classList.contains('sdots'))[...d.children].forEach((x,n)=>x.classList.toggle('on',n===i));
  const b=t.previousElementSibling;if(!car&&b&&b.classList.contains('stabs'))[...b.children].forEach((x,n)=>x.classList.toggle('on',n===i));
}
document.addEventListener('scroll',e=>{const t=e.target;if(t.classList&&(t.classList.contains('car')||t.classList.contains('sl')))upd(t)},true);

function render(){
  const c=$('.car'),x=c?c.scrollLeft:0;
  $('#nav').innerHTML='<div>'+NAV.map(n=>`<button data-a="tab" data-v="${n[0]}" class="${tab===n[0]?'on':''}">${I(n[1],24)}${n[2]}</button>`).join('')+'</div>';
  $('#app').innerHTML=({home:vHome,cal:vCal,pack:vPack,rem:vRem,mem:vMem,help:vHelp})[tab]();
