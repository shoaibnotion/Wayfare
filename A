  return `<div class="ticket" data-a="pick" data-v="${t.id}" role="button" tabindex="0"><div class="tk"><div class="tk-top"><span class="k">${lbl}</span><div class="tk-actions"><button class="tk-btn" data-a="openT" data-v="${t.id}">${I('cal',13)} Schedule</button><button class="tk-btn" data-a="editTrip" data-v="${t.id}">${I('edit',13)} Edit</button></div></div><h2>${esc(t.name)}</h2><p>${esc(t.dest||'')}${t.dest?' · ':''}${fmt(t.start)} to ${fmt(t.end)}${t.type?' · '+esc(t.type):''}</p></div><div class="cut"></div><div class="stub"><div><b class="n">${n}</b><span class="u">${now?'days left':'days to go'}</span></div><div class="g"><span>${pk.length?dn+' of '+pk.length+' items packed':'Packing list is empty'}</span><div class="bar"><i style="width:${p}%"></i></div></div></div>
  ${allDone?'<div class="clw" style="padding:10px 18px 12px"><div class="clh" style="margin:0"><span>All packed ✓</span></div></div>':`<div class="clw"><div class="clh"><span>${!pk.length?'No packing list yet':lf.length?'Left to pack · '+lf.length:'All packed'}</span>${il?`<b class="rp">${il} important</b>`:''}</div>${items}${lf.length>5?`<div class="more">+${lf.length-5} more · tap the trip to open</div>`:''}${!pk.length?'<div class="more">Tap to build your packing list</div>':''}</div>`}</div>`;
}

function vHome(){
  const up=upcoming(),h=new Date().getHours(),g=h<12?'Good morning':h<18?'Good afternoon':'Good evening';let hero='';
  if(up.length)hero=`<div class="car ${up.length>1?'multi':''}">${up.map(ticketHtml).join('')}</div>`+(up.length>1?`<div class="sdots">${up.map((_,i)=>`<i class="${i?'':'on'}"></i>`).join('')}</div>`:'');
  else hero=`<div class="list empty"><b>${past().length?'No upcoming trips':'Plan your first holiday'}</b>${past().length?'Your finished trips are in Memories.':'Add a trip with its start and end dates and your boarding pass appears here.'}<br><br><button class="btn sm" data-a="tab" data-v="cal" style="margin:auto">Add a trip</button></div>`;
  return hd(g,new Date().toLocaleDateString(undefined,{weekday:'long',day:'numeric',month:'long'}))+hero+
  `<div class="tiles">${[['cal','cal','Trips'],['pack','bag','Pack'],['rem','bell','Remind'],['mem','img','Memories']].map(x=>`<button class="tile" data-a="tab" data-v="${x[0]}"><span>${I(x[1],24)}</span>${x[2]}</button>`).join('')}</div>`+
  (D.trips.length||LS.g('wf_guide')?'':`<button class="tour-link" data-a="tab" data-v="help"><span class="ico">${I('help')}</span><span class="t"><b>New here?</b><span class="s">See how Wayfare works in one minute</span></span>${I('chev')}</button>`)+
  `<div class="row"><h2>Your holidays</h2><button class="plus" data-a="tab" data-v="cal" aria-label="Add a trip">${I('plus',22)}</button></div>`+(up.length?holList(up)+`<p class="note">Swipe the boarding passes above, or tap a holiday to open its packing list.</p>`:`<p class="sub" style="margin:0 4px">Holidays you save appear here.</p>`);
}

function vCal(){
  const{y,m}=cm,f=new Date(y,m,1),off=(f.getDay()+6)%7,n=new Date(y,m+1,0).getDate(),up=upcoming();
  const minDate=editId?'':today;
  let c=['Mon','Tue','Wed','Thu','Fri','Sat','Sun'].map(w=>`<div class="w">${w}</div>`).join('')+'<div></div>'.repeat(off);
  for(let i=1;i<=n;i++){
    const k=iso(new Date(y,m,i));let q='day';
    if(sel.s===k)q+=' s';if(sel.e===k)q+=' e';if(sel.s&&sel.e&&k>sel.s&&k<sel.e)q+=' in';if(k===today)q+=' today';
