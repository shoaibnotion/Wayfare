<script>
const $=s=>document.querySelector(s),esc=s=>String(s==null?'':s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const LS={g(k){try{return localStorage.getItem(k)}catch(e){return null}},s(k,v){try{localStorage.setItem(k,v);return true}catch(e){return false}},d(k){try{localStorage.removeItem(k)}catch(e){}}};
const uid=()=>Math.random().toString(36).slice(2,10),iso=d=>d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
const pd=s=>{const[a,b,c]=s.split('-').map(Number);return new Date(a,b-1,c)},fmt=(s,o)=>pd(s).toLocaleDateString(undefined,o||{day:'numeric',month:'short'}),today=iso(new Date()),days=(a,b)=>Math.round((pd(b)-pd(a))/864e5);

const P={
  home:'<path d="M3 11l9-8 9 8v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>',
