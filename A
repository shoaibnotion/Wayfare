const hd=(t,s)=>`<div class="hd"><div><small>${s}</small><h1>${t}</h1></div><button class="ib" data-a="tab" data-v="help" aria-label="How to use Wayfare">${I('help',22)}</button></div>`;

function ticketHtml(t,i){
  const now=today>=t.start&&today<=t.end,d=days(today,t.start),n=now?days(today,t.end):Math.abs(d),pk=D.pack[t.id]||[],dn=pk.filter(x=>x.done).length,p=pk.length?dn/pk.length*100:0,lf=byImp(pk.filter(x=>!x.done)),il=lf.filter(x=>x.imp).length,allDone=pk.length>0&&!lf.length;
