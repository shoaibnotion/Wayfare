<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Wayfare – Holiday Planner</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#eef2f1;--card:#fff;--ink:#0c1a1d;--mute:#5f7478;--line:#dfe7e6;--acc:#0b6e78;--on:#fff;--soft:#e5efee;--gold:#c9962f;--red:#d6453d;--redsoft:#fdeceb;--sh:0 1px 1px rgba(8,30,34,.04),0 12px 28px -16px rgba(8,30,34,.28);--nav:rgba(255,255,255,.8);--serif:Fraunces,Georgia,serif;color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#071316;--card:#0e2024;--ink:#eaf3f3;--mute:#86a2a6;--line:#1a3338;--acc:#47c4ce;--on:#04181c;--soft:#123037;--gold:#e3b24f;--red:#ff7b72;--redsoft:#3a1c1e;--nav:rgba(7,19,22,.82);color-scheme:dark}}
:root[data-theme="dark"]{--bg:#071316;--card:#0e2024;--ink:#eaf3f3;--mute:#86a2a6;--line:#1a3338;--acc:#47c4ce;--on:#04181c;--soft:#123037;--gold:#e3b24f;--red:#ff7b72;--redsoft:#3a1c1e;--nav:rgba(7,19,22,.82);color-scheme:dark}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{margin:0;background:var(--bg);color:var(--ink);font:500 15px/1.5 Inter,-apple-system,system-ui,sans-serif}
body::before{content:"";position:fixed;top:0;left:0;right:0;height:env(safe-area-inset-top,0px);background:var(--bg);z-index:6}
button,input,select,textarea{font:inherit;color:inherit}button{border:0;background:none;cursor:pointer;padding:0}
:focus-visible{outline:2px solid var(--acc);outline-offset:2px}
h1,h2,h3,p{margin:0}
#app{max-width:540px;margin:0 auto;padding:18px 18px 120px}
.hd{display:flex;justify-content:space-between;align-items:flex-end;margin:8px 0 22px}
.hd small{color:var(--mute);font-weight:500;font-size:13px}.hd h1{font:600 34px/1.1 var(--serif);letter-spacing:-.02em;margin-top:2px}
.ib{width:42px;height:42px;border-radius:50%;background:var(--card);box-shadow:var(--sh);display:grid;place-items:center;color:var(--acc);flex:none}
h2{font:600 21px/1.2 var(--serif);letter-spacing:-.01em;margin:28px 2px 10px}
.sub,.sm{color:var(--mute);font-size:13px}
.list{background:var(--card);border-radius:20px;box-shadow:var(--sh);overflow:hidden;margin-bottom:14px}
.li{display:flex;align-items:center;gap:13px;padding:14px 16px;border-bottom:1px solid var(--line);width:100%;text-align:left}
.li:last-child{border:0}.li .t{flex:1;min-width:0}.li .t b{display:block;font-weight:600}.t>.sub{display:block}
.ico{width:36px;height:36px;border-radius:11px;background:var(--soft);color:var(--acc);display:grid;place-items:center;flex:none}
.li>svg:last-child{color:var(--mute);flex:none}

/* Boarding Pass Ticket */
.ticket{background:linear-gradient(150deg,#118793,#06343c);color:#fff;border-radius:28px;box-shadow:0 22px 40px -22px rgba(6,52,60,.7);overflow:hidden}
.tk{padding:24px 24px 20px}
.tk-top{display:flex;justify-content:space-between;align-items:center;gap:8px}
.tk .k{font-size:13px;color:#f0cf85;font-weight:600}
.tk-actions{display:flex;gap:6px}
.tk-btn{background:rgba(255,255,255,.14);color:#fff;border-radius:99px;padding:5px 11px;font-size:12px;font-weight:600;display:inline-flex;align-items:center;gap:5px}
.tk h2{font:600 32px/1.1 var(--serif);margin:6px 0 6px;color:#fff;letter-spacing:-.02em}.tk p{opacity:.82;font-size:14px}
.cut{position:relative;border-top:2px dashed rgba(255,255,255,.28)}
.cut:before,.cut:after{content:"";position:absolute;top:-13px;width:24px;height:24px;border-radius:50%;background:var(--bg)}.cut:before{left:-12px}.cut:after{right:-12px}
.stub{display:flex;align-items:center;gap:20px;padding:18px 24px 22px}
.stub .n{font:600 50px/1 var(--serif);letter-spacing:-.03em;display:block}.stub .u{font-size:12px;opacity:.8}
.stub .g{flex:1}.stub .g span{font-size:13px;opacity:.85}
.bar{height:6px;background:rgba(255,255,255,.2);border-radius:9px;margin-top:8px;overflow:hidden}.bar i{display:block;height:100%;background:#f0cf85;border-radius:9px}

/* Home Carousel */
.car{display:flex;align-items:flex-start;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding:2px 2px 26px;margin:0 -2px -14px;-webkit-overflow-scrolling:touch}
.car::-webkit-scrollbar,.sl::-webkit-scrollbar{display:none}
.car .ticket{flex:0 0 100%;scroll-snap-align:start;cursor:pointer;min-width:0}
.car.multi .ticket{flex-basis:88%}
.sdots{display:flex;gap:6px;justify-content:center;margin:2px 0 8px}.sdots i{width:6px;height:6px;border-radius:9px;background:var(--line);transition:.2s}.sdots i.on{width:18px;background:var(--acc)}
.clw{border-top:1px solid rgba(255,255,255,.18);padding:14px 18px 18px}
.clh{display:flex;justify-content:space-between;align-items:center;font-size:11px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;opacity:.92;margin-bottom:10px}
.rp{background:#ff5d52;color:#fff;border-radius:99px;padding:3px 10px;font-size:11px}
.cl{display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:12px;background:rgba(255,255,255,.09);margin-bottom:6px;font-size:14px}
.cl.imp{background:rgba(255,93,82,.24);box-shadow:inset 3px 0 0 #ff5d52}
.cl span{flex:1;min-width:0}.cl em{font-style:normal;font-size:10px;font-weight:700;color:#ffc0ba;text-transform:uppercase;letter-spacing:.04em}
.cb{width:22px;height:22px;border-radius:50%;border:2px solid rgba(255,255,255,.55);flex:none;position:relative}.cb:after{content:"";position:absolute;inset:-9px}
.cl.imp .cb{border-color:#ff8a82}
.more{font-size:12px;opacity:.75;margin-top:4px}

/* Tiles & Buttons */
.tiles{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:14px}
.tile{background:var(--card);border-radius:18px;padding:14px 4px 11px;display:flex;flex-direction:column;align-items:center;gap:7px;font-size:12px;font-weight:600;box-shadow:var(--sh)}
.tile span{color:var(--acc)}
.tour-link{width:100%;margin-top:14px;background:var(--card);border-radius:18px;padding:14px 16px;display:flex;align-items:center;gap:12px;text-align:left;box-shadow:var(--sh);border:1px solid color-mix(in srgb,var(--gold) 45%,transparent)}
.tour-link .ico{background:color-mix(in srgb,var(--gold) 18%,transparent);color:var(--gold)}.tour-link .t{flex:1}.tour-link b{display:block;font-weight:600}.tour-link span.s{font-size:13px;color:var(--mute)}
.btn{display:flex;align-items:center;justify-content:center;gap:8px;background:var(--acc);color:var(--on);font-weight:600;border-radius:15px;padding:15px 18px;width:100%}
.btn.soft{background:var(--soft);color:var(--ink)}.btn.sm{width:auto;padding:9px 16px;font-size:13px;border-radius:11px}.btn.red{background:transparent;color:var(--red)}
.btn-row{display:flex;gap:8px;margin-top:10px}
.f{display:block;padding:12px 16px;border-bottom:1px solid var(--line)}.f:last-child{border:0}
.f span{display:block;font-size:12px;color:var(--mute);font-weight:600}
.f input,.f select,.f textarea{width:100%;border:0;background:none;padding:3px 0;outline:0;font-weight:500}
.f-grid{display:grid;grid-template-columns:1fr 1fr;border-bottom:1px solid var(--line)}.f-grid .f{border-bottom:0}.f-grid .f:first-child{border-right:1px solid var(--line)}
.seg{display:flex;background:var(--soft);border-radius:13px;padding:3px;gap:3px}.seg button{flex:1;padding:9px;border-radius:10px;font-weight:600;font-size:13px;color:var(--mute)}.seg button.on{background:var(--card);color:var(--ink);box-shadow:var(--sh)}
.seg button.on.red{background:var(--red);color:#fff}

/* Calendar */
.cal{background:var(--card);border-radius:22px;padding:16px;box-shadow:var(--sh);margin-bottom:14px}
.ch{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}.ch h3{font:600 19px var(--serif)}
.ch button{width:36px;height:36px;border-radius:50%;background:var(--soft);display:grid;place-items:center;font-size:20px}
.grid{display:grid;grid-template-columns:repeat(7,1fr);row-gap:4px}.w{text-align:center;font-size:12px;color:var(--mute);font-weight:600;padding-bottom:6px}
.day{aspect-ratio:1;display:grid;place-items:center;font-weight:600;position:relative;margin:0 auto;width:100%;max-width:46px;border-radius:50%}
.day.in{background:var(--soft);border-radius:0}.day.s,.day.e{background:var(--acc);color:var(--on)}
.day.today{box-shadow:inset 0 0 0 2px var(--gold)}.day.hol:after{content:"";position:absolute;bottom:4px;width:5px;height:5px;border-radius:50%;background:var(--gold)}

/* Packing & Progress */
.prog{display:flex;align-items:center;gap:16px;background:var(--card);border-radius:22px;padding:16px;box-shadow:var(--sh);margin-bottom:14px}
.ring{width:68px;height:68px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(var(--acc) calc(var(--p)*1%),var(--soft) 0);flex:none}.ring span{width:54px;height:54px;border-radius:50%;background:var(--card);display:grid;place-items:center;font:600 16px var(--serif)}
.cat{font-size:13px;font-weight:600;color:var(--mute);padding:14px 16px 4px}
.ck{width:26px;height:26px;border-radius:50%;border:2px solid var(--line);display:grid;place-items:center;color:transparent;flex:none}
.done .ck,.ck.fill{background:var(--acc);border-color:var(--acc);color:var(--on)}.done .t{text-decoration:line-through;color:var(--mute)}
.li.imp{background:var(--redsoft);box-shadow:inset 4px 0 0 var(--red)}
.imp .ck{border-color:var(--red)}.imp.done .ck,.imp .ck.fill{background:var(--red);border-color:var(--red);color:#fff}
.qty{display:inline-flex;align-items:center;gap:4px;background:var(--soft);border-radius:8px;padding:2px 6px;font-size:12px;font-weight:700;color:var(--ink)}
.qty button{width:18px;height:18px;display:grid;place-items:center;color:var(--acc);font-weight:700}
.sbar{display:flex;gap:8px;margin-bottom:12px}
.sbar input{flex:1;background:var(--card);border:0;border-radius:14px;padding:10px 14px;box-shadow:var(--sh);outline:0}
.secH{display:flex;align-items:center;justify-content:space-between;gap:8px;font-weight:700;font-size:12px;text-transform:uppercase;letter-spacing:.05em;color:var(--mute);margin:18px 4px 8px}
.secH span{display:inline-flex;align-items:center;gap:8px}
.secH span:before{content:"";width:9px;height:9px;border-radius:50%;background:var(--acc)}.secH.red{color:var(--red)}.secH.red span:before{background:var(--red)}
.rd{color:var(--red);font-weight:700}
.x{color:var(--mute);padding:6px;font-size:16px}

/* Memories & Cards */
.mem{columns:2;column-gap:10px}.mem button{display:block;width:100%;margin-bottom:10px;border-radius:18px;overflow:hidden;position:relative;break-inside:avoid;background:var(--soft)}
.mem img{width:100%;display:block}.mem span{position:absolute;inset:auto 0 0;padding:28px 11px 10px;color:#fff;font-size:12px;font-weight:600;text-align:left;background:linear-gradient(transparent,rgba(0,0,0,.72))}
.sheet .mem img,.sheet .cov img{margin:0;border-radius:0}
.mc{display:flex;align-items:center;gap:13px;padding:12px 14px;width:100%;text-align:left;background:var(--card);border-radius:20px;box-shadow:var(--sh);margin-bottom:12px}
.cov{width:68px;height:68px;border-radius:16px;background:linear-gradient(150deg,#118793,#06343c);display:grid;place-items:center;color:#f0cf85;overflow:hidden;flex:none}.cov img{width:100%;height:100%;object-fit:cover}
.mc .t{flex:1;min-width:0}.mc .t>*{display:block}.mc b{font-weight:600}.mc>svg{color:var(--mute);flex:none}
.mm{display:flex!important;gap:6px;margin-top:6px;flex-wrap:wrap}.mm span{font-size:11px;font-weight:700;padding:3px 9px;border-radius:99px;background:var(--soft);color:var(--acc)}
.empty{text-align:center;padding:34px 18px;color:var(--mute)}.empty b{display:block;font:600 18px var(--serif);color:var(--ink);margin-bottom:4px}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}.chip{padding:7px 14px;border-radius:99px;background:var(--card);font-weight:600;font-size:13px;box-shadow:var(--sh)}.chip.on{background:var(--acc);color:var(--on)}
.chp{display:inline-flex;align-items:center;gap:6px;padding:7px 12px;border-radius:99px;background:var(--soft);font-size:13px;font-weight:600}.chp svg{color:var(--acc)}
.chp.imp{background:var(--redsoft);color:var(--red);box-shadow:inset 0 0 0 1.5px var(--red)}.chp.imp svg{color:var(--red)}.chp.mut{opacity:.7}

/* Bottom Nav & Sheets */
nav{position:fixed;left:0;right:0;bottom:0;background:var(--nav);backdrop-filter:blur(22px) saturate(1.4);-webkit-backdrop-filter:blur(22px) saturate(1.4);border-top:1px solid var(--line);padding:6px 8px calc(6px + env(safe-area-inset-bottom,0px));z-index:5}
nav div{max-width:540px;margin:0 auto;display:flex}nav button{flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;padding:6px 0;font-size:11px;font-weight:600;color:var(--mute)}nav button.on{color:var(--acc)}
.ov{position:fixed;inset:0;background:rgba(2,12,15,.55);z-index:10;display:flex;align-items:flex-end;justify-content:center}
.sheet{background:var(--bg);width:min(540px,100%);border-radius:28px 28px 0 0;padding:10px 18px calc(22px + env(safe-area-inset-bottom,0px));max-height:92%;overflow:auto;animation:up .25s ease-out}
.sheet:before{content:"";display:block;width:40px;height:5px;border-radius:9px;background:var(--line);margin:0 auto 14px}
.sheet>img{width:100%;border-radius:18px;margin-bottom:12px}
.mh{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px}
.sl{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;gap:12px;margin-top:12px;scroll-behavior:auto}
.slide{flex:0 0 100%;scroll-snap-align:start;max-height:56vh;overflow-y:auto;min-width:0}
.sum{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:12px}.sum div{background:var(--card);border-radius:16px;padding:10px;text-align:center;box-shadow:var(--sh)}.sum b{display:block;font:600 22px var(--serif)}.sum span{font-size:11px;color:var(--mute);font-weight:600}
@keyframes up{from{transform:translateY(30px);opacity:0}}
.note{font-size:12px;color:var(--mute);text-align:center;margin-top:12px}
.toast{position:fixed;top:calc(12px + env(safe-area-inset-top,0px));left:50%;transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:12px 18px;border-radius:14px;font-weight:600;z-index:40;max-width:90%;box-shadow:var(--sh)}

/* Onboarding Tour */
.tour{position:fixed;inset:0;z-index:30;background:linear-gradient(170deg,#118793,#04252b);color:#fff;display:flex;flex-direction:column;padding:calc(18px + env(safe-area-inset-top,0px)) 28px calc(26px + env(safe-area-inset-bottom,0px))}
.tour .sk{align-self:flex-end;color:rgba(255,255,255,.8);font-weight:600;padding:8px}
.tour .mid{flex:1;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;max-width:380px;margin:0 auto}
.tour .ic{width:116px;height:116px;border-radius:50%;background:rgba(255,255,255,.1);border:1px solid rgba(240,207,133,.5);display:grid;place-items:center;color:#f0cf85;margin-bottom:30px;animation:pop .35s ease-out}
.tour h2{font-size:32px;color:#fff;margin:0 0 12px}.tour p{font-size:16px;opacity:.86;line-height:1.55}
.dots{display:flex;gap:7px;justify-content:center;margin:0 0 20px}.dots i{width:7px;height:7px;border-radius:9px;background:rgba(255,255,255,.3);transition:.2s}.dots i.on{width:22px;background:#f0cf85}
.tour .btn{background:#f0cf85;color:#2a1c00;max-width:380px;margin:0 auto}
@keyframes pop{from{transform:scale(.85);opacity:0}}

/* Utility */
.row{display:flex;justify-content:space-between;align-items:flex-end}.row h2{margin-bottom:10px}.row .btn.sm{margin-bottom:10px}
.plus{width:42px;height:42px;border-radius:50%;background:var(--acc);color:var(--on);display:grid;place-items:center;box-shadow:var(--sh);margin-bottom:8px;flex:none}
.sg{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:6px}.sg button{padding:8px 13px 8px 10px;border-radius:99px;background:var(--card);box-shadow:var(--sh);font-size:13px;font-weight:600;display:flex;gap:6px;align-items:center}.sg button svg{color:var(--acc)}
.sg button.imp{box-shadow:inset 0 0 0 1.5px var(--red)}.sg button.imp svg{color:var(--red)}
.im{font-style:normal;font-size:11px;font-weight:700;color:var(--red);margin-left:8px}
.left{display:block;font-size:13px;margin-top:3px;color:var(--mute)}.left b{color:var(--ink);font-weight:600}
.tg{margin-bottom:10px}.th{display:flex;justify-content:space-between;align-items:center;gap:10px;margin:20px 2px 8px}.th b{font:600 19px var(--serif);display:block}
.pk{background:var(--card);border-radius:20px;box-shadow:var(--sh);padding:14px 16px;margin-bottom:14px}.pkh{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--mute);margin-bottom:10px}.cw{display:flex;flex-wrap:wrap;gap:8px}
.legend{display:flex;gap:14px;font-size:12px;color:var(--mute);margin:0 4px 6px}.legend i{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:5px;background:var(--acc)}.legend i.r{background:var(--red)}
.pc{background:var(--card);border-radius:20px;box-shadow:var(--sh);padding:14px 16px;margin-bottom:12px}
.pch{display:flex;align-items:center;gap:10px;width:100%;text-align:left}.pch .t{flex:1;min-width:0}.pch .t b{display:block;font:600 18px var(--serif)}.pch>svg{color:var(--mute);flex:none}
.pcs{display:flex;justify-content:space-between;gap:10px;font-size:13px;margin:12px 0 7px;color:var(--mute)}.pcs b{color:var(--ink);font-weight:700}
.pbar{height:6px;background:var(--soft);border-radius:9px;overflow:hidden}.pbar i{display:block;height:100%;background:var(--acc);border-radius:9px}
.pc.ok .pbar i{background:var(--gold)}.pca{margin-top:12px;display:flex;gap:8px;flex-wrap:wrap}
.bk{display:inline-flex;align-items:center;gap:4px;color:var(--acc);font-weight:600;margin:-8px 0 14px;padding:6px 2px}.bk svg{transform:rotate(180deg)}
.rng{background:linear-gradient(150deg,#118793,#06343c);color:#fff;border-radius:26px;padding:18px;box-shadow:0 22px 40px -22px rgba(6,52,60,.7);margin-bottom:14px}
.rg{display:flex;align-items:stretch;gap:8px}
.rt{flex:1;position:relative;background:rgba(255,255,255,.09);border:1.5px solid rgba(255,255,255,.16);border-radius:20px;padding:13px 14px;min-width:0;transition:.2s}
.rt.act{border-color:#f0cf85;background:rgba(240,207,133,.15)}
.rt small{display:block;font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:#f0cf85}
.rt b{display:block;font:600 38px/1.05 var(--serif);letter-spacing:-.02em;margin-top:4px}
.rt span{font-size:13px;opacity:.85}
.rt input{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer}
.rmid{display:grid;place-items:center;color:#f0cf85;flex:none}
.rsum{margin-top:14px;text-align:center;font-size:13px;font-weight:600;color:#f0cf85}
.rsum em{font-style:normal;display:inline-block;background:rgba(240,207,133,.16);border-radius:99px;padding:5px 14px;color:#fff}
.day.off{opacity:.3}
.badge{display:inline-block;padding:2px 8px;border-radius:99px;font-size:11px;font-weight:700;background:var(--soft);color:var(--acc)}
.it-item{display:flex;gap:10px;align-items:flex-start;padding:7px 10px;background:var(--soft);border-radius:11px;margin-top:6px;font-size:13px}
.it-item b{color:var(--acc);font-weight:700;flex:none}
.it-item span{flex:1}
.edit-banner{background:color-mix(in srgb,var(--gold) 18%,transparent);border:1px solid color-mix(in srgb,var(--gold) 50%,transparent);border-radius:16px;padding:10px 14px;margin-bottom:12px;display:flex;justify-content:space-between;align-items:center;font-size:13px;font-weight:600}

/* Print Dossier Styles */
#printArea{display:none}
@media print{
  body>*:not(#printArea){display:none!important}
  #printArea{display:block!important;padding:20px;color:#000;background:#fff;font:13px/1.45 Inter,sans-serif}
  #printArea h1{font:700 26px Georgia,serif;margin-bottom:4px}
  #printArea h2{font:700 16px Georgia,serif;margin:18px 0 6px;border-bottom:1px solid #ccc;padding-bottom:3px}
  .p-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
