    }
    const oth=rm.filter(r=>r.date<t.start||r.date>t.end);
    const bkHtml=bks.length?`<div class="list">${bks.map(b=>`<div class="li"><span class="ico">${I('cal',18)}</span><div class="t"><b>${esc(b.title)} <span class="badge">${esc(b.type)}</span></b><span class="sub">${b.ref?`Ref: <b>${esc(b.ref)}</b> · `:''}${esc(b.info||'')}</span></div><button class="x" data-a="delBk" data-v="${b.id}">${I('x',16)}</button></div>`).join('')}</div>`:'';

    const s1=`<div class="slide"><div class="sum"><div><b>${dur}</b><span>days</span></div><div><b>${taken.length}</b><span>taken</span></div><div><b>${ph.length}</b><span>photos</span></div></div><div class="list"><div class="li"><span class="ico">${I('cal')}</span><div class="t"><b>${fmt(t.start,{day:'numeric',month:'short'})} to ${fmt(t.end,{day:'numeric',month:'short',year:'numeric'})}</b><span class="sub">${esc(t.dest||'No destination')}${t.type?' · '+esc(t.type):''}</span></div></div></div><div class="secH"><span>Bookings & References (${bks.length})</span><button class="badge" data-a="newBk">+ Add</button></div>${bkHtml||`<div class="list"><div class="li"><span class="sub">Save flight numbers, hotel refs, or train seats here.</span></div></div>`}<div class="secH"><span>Day by day</span></div><div class="list">${dl}</div>${oth.length?`<div class="secH"><span>Other reminders</span></div><div class="list">${oth.map(r=>`<div class="li"><div class="t"><b>${esc(r.text)}</b><span class="sub">${fmt(r.date)} at ${r.time}</span></div></div>`).join('')}</div>`:''}</div>`;

    // Slide 1: Things taken
    const trow=i=>`<div class="li ${i.imp?'imp':''}"><span class="ck fill">${I('check',15)}</span><span class="t">${i.q>1?`<b>${i.q}×</b> `:''}${esc(i.t)} <span class="sub">· ${i.c}</span></span></div>`;
    const ti2=taken.filter(i=>i.imp),to=taken.filter(i=>!i.imp);
    const s2=`<div class="slide">${taken.length?(ti2.length?`<div class="secH red"><span>Important · ${ti2.length}</span></div><div class="list">${ti2.map(trow).join('')}</div>`:'')+(to.length?`<div class="secH"><span>Other things · ${to.length}</span></div><div class="list">${to.map(trow).join('')}</div>`:''):`<div class="empty"><b>Nothing ticked</b>Things you tick off in Packing show here. You can add some below.</div>`}${left.length?`<div class="secH"><span>Not ticked</span></div><div class="cw" style="margin-bottom:12px">${byImp(left).map(i=>`<span class="chp mut ${i.imp?'imp':''}">${i.q>1?i.q+'× ':''}${esc(i.t)}</span>`).join('')}</div>`:''}<div class="list"><label class="f"><span>Add something you took</span><input id="tk" placeholder="Camera"></label><label class="f"><span>Type</span><select id="tki"><option value="0">Other thing</option><option value="1">Important</option></select></label></div><button class="btn soft" data-a="addTaken">Add to things taken</button></div>`;

    // Slide 2: Pictures
    const s3=`<div class="slide">${ph.length?memCards(ph):`<div class="empty"><b>No pictures yet</b>Add photos from this trip.</div>`}<button class="btn" data-a="addMem" data-v="${v}">Add a photo</button></div>`;

    // Slide 3: Notes
    const nts=t.notes||[],nx=nts.filter(n=>n.k==='next'),ni=nts.filter(n=>n.k==='imp'),nrow=n=>`<div class="li ${n.k==='imp'?'imp':''}"><span class="t">${esc(n.text)}</span><button class="x" data-a="delNote" data-v="${n.id}" aria-label="Delete note">${I('x',16)}</button></div>`;
    const s4=`<div class="slide">${nx.length?`<div class="secH"><span>Remember next time · ${nx.length}</span></div><div class="list">${nx.map(nrow).join('')}</div>`:''}${ni.length?`<div class="secH red"><span>Important points · ${ni.length}</span></div><div class="list">${ni.map(nrow).join('')}</div>`:''}${!nts.length?`<div class="empty"><b>No notes yet</b>Write what to remember next time, or an important point about this trip.</div>`:''}<div class="list"><label class="f"><span>Write a note</span><textarea id="nt" rows="3" placeholder="Book the ferry earlier"></textarea></label><label class="f"><span>Type</span><select id="nk"><option value="next">Remember next time</option><option value="imp">Important point</option></select></label></div><button class="btn soft" data-a="addNote">Add note</button></div>`;

    sheet(`<div class="mh"><div><span class="sub">${esc(t.dest||'')}</span><h2 style="margin:2px 0 0">${esc(t.name)}</h2></div><div style="display:flex;gap:4px"><button class="x" data-a="printTrip" data-v="${v}" title="Print / PDF">${I('print',19)}</button><button class="x" data-a="editTrip" data-v="${v}" title="Modify trip">${I('edit',19)}</button><button class="x" data-a="close" aria-label="Close">${I('x',20)}</button></div></div><div class="seg stabs">${['Schedule','Things taken','Pictures','Notes'].map((n,i)=>`<button class="${i===slI?'on':''}" data-a="slide" data-v="${i}">${n}</button>`).join('')}</div><div class="sl">${s1}${s2}${s3}${s4}</div><div class="sdots">${[0,1,2,3].map(i=>`<i class="${i===slI?'on':''}"></i>`).join('')}</div><button class="btn red" data-a="delTrip" data-v="${v}" style="margin-top:10px">Delete this trip</button>`);
    const sl=$('#ov .sl');if(sl)sl.scrollLeft=slI*sl.clientWidth;
  },
  printTrip(v){printTripDossier(v)},
  newItin(dt){
    const v=curT;
    sheet(`<h2 style="margin-top:4px">Add plan for ${fmt(dt,{weekday:'short',day:'numeric',month:'short'})}</h2>
      <div class="list">
        <div class="f-grid">
          <label class="f"><span>Time</span><input id="itTm" type="time" value="10:00"></label>
          <label class="f"><span>Location / Area</span><input id="itLc" placeholder="Old Town"></label>
        </div>
        <label class="f"><span>Activity</span><input id="itTl" placeholder="Guided walking tour & lunch"></label>
      </div>
      <div class="btn-row"><button class="btn soft" data-a="openTab" data-v="${v}|0">Cancel</button><button class="btn" data-a="saveItin" data-v="${dt}">Save plan</button></div>`);
  },
  saveItin(dt){
    const v=curT,t=D.trips.find(x=>x.id===v),tl=$('#itTl').value.trim();if(!tl)return toast('Enter an activity');
    t.itin=t.itin||{};t.itin[dt]=t.itin[dt]||[];
    t.itin[dt].push({id:uid(),time:$('#itTm').value,loc:$('#itLc').value.trim(),title:tl});
    save();render();slI=0;A.openTrip(v);
  },
  delItin(v){
    const[dt,id]=v.split('|'),t=D.trips.find(x=>x.id===curT);if(!t||!t.itin||!t.itin[dt])return;
    t.itin[dt]=t.itin[dt].filter(x=>x.id!==id);save();render();slI=0;A.openTrip(curT);
  },
  newBk(){
    const v=curT;
    sheet(`<h2 style="margin-top:4px">Add booking reference</h2>
      <div class="list">
        <div class="f-grid">
          <label class="f"><span>Type</span><select id="bkTp"><option>Flight</option><option>Hotel</option><option>Train / Bus</option><option>Car Rental</option><option>Event / Tour</option></select></label>
          <label class="f"><span>Ref / PNR Code</span><input id="bkRf" placeholder="XY89KL"></label>
        </div>
        <label class="f"><span>Provider / Name</span><input id="bkTl" placeholder="IndiGo 6E-204 / Grand Hotel"></label>
        <label class="f"><span>Details (Terminal, Check-in, Seat)</span><input id="bkIn" placeholder="Terminal 2 · Check-in 14:00"></label>
      </div>
      <div class="btn-row"><button class="btn soft" data-a="openTab" data-v="${v}|0">Cancel</button><button class="btn" data-a="saveBk">Save booking</button></div>`);
  },
  saveBk(){
    const v=curT,t=D.trips.find(x=>x.id===v),tl=$('#bkTl').value.trim();if(!tl)return toast('Enter a booking name');
    (t.bookings=t.bookings||[]).push({id:uid(),type:$('#bkTp').value,ref:$('#bkRf').value.trim(),title:tl,info:$('#bkIn').value.trim()});
    save();render();slI=0;A.openTrip(v);
  },
  delBk(id){
    const t=D.trips.find(x=>x.id===curT);if(!t)return;
    t.bookings=(t.bookings||[]).filter(b=>b.id!==id);save();render();slI=0;A.openTrip(curT);
  },
  addNote(){const v=curT,t=D.trips.find(x=>x.id===v),x=$('#nt').value.trim();if(!x)return toast('Write your note first');(t.notes=t.notes||[]).push({id:uid(),k:$('#nk').value,text:x});save();render();slI=3;A.openTrip(v)},
  delNote(v){const t=D.trips.find(x=>x.id===curT);if(!t)return;t.notes=(t.notes||[]).filter(n=>n.id!==v);save();render();slI=3;A.openTrip(curT)},
  addTaken(){const v=curT,n=$('#tk').value.trim();if(!n)return toast('Type an item first');const pk=D.pack[v]=D.pack[v]||[];pk.push({id:uid(),t:n,c:'Misc',q:1,done:true,imp:$('#tki').value==='1'});save();render();slI=1;A.openTrip(v)},
  addPast(){const y=addD(today,-1);sheet(`<h2 style="margin-top:4px">Add a past trip</h2><div class="list"><label class="f"><span>Trip name</span><input id="pn" placeholder="Goa with friends"></label><label class="f"><span>Destination</span><input id="pdst" placeholder="Goa, India"></label><label class="f"><span>Holiday type</span><select id="pty">${Object.keys(TYPES).map(k=>`<option>${k}</option>`).join('')}</select></label><label class="f"><span>First day</span><input id="ps" type="date" max="${y}" value="${addD(today,-7)}"></label><label class="f"><span>Last day</span><input id="pe" type="date" max="${y}" value="${addD(today,-3)}"></label></div><button class="btn" data-a="savePast">Save trip</button>`)},
  savePast(){const s=$('#ps').value,e=$('#pe').value;if(!s||!e||e<s)return toast('Check your dates');if(e>=today)return toast('A past trip must end before today');const t={id:uid(),name:$('#pn').value.trim()||'Past trip',dest:$('#pdst').value.trim(),type:$('#pty').value,start:s,end:e,itin:{},bookings:[]};D.trips.push(t);D.pack[t.id]=[];save();render();A.openT(t.id)},
  addMem(v){const ps=past(),def=v||(ps[0]||{}).id||'',all=[...ps,...upcoming()];sheet(`<h2 style="margin-top:4px">New memory</h2><div class="list"><label class="f"><span>Trip</span><select id="mtr"><option value="">No trip</option>${all.map(t=>`<option value="${t.id}" ${t.id===def?'selected':''}>${esc(t.name)}</option>`).join('')}</select></label><label class="f"><span>Photo</span><input id="mp" type="file" accept="image/*"></label><label class="f"><span>Title</span><input id="mt" placeholder="Sunset in Santorini"></label><label class="f"><span>Date</span><input id="md" type="date" value="${today}"></label><label class="f"><span>Note</span><textarea id="mn" rows="3" placeholder="What do you want to remember?"></textarea></label></div><button class="btn" data-a="saveMem">Save memory</button><button class="btn soft" data-a="back" data-v="${v||''}" style="margin-top:10px">Cancel</button>`)},
  async saveMem(){const f=$('#mp').files[0];if(!f)return toast('Choose a photo first');try{const tr=$('#mtr').value;D.mem.push({id:uid(),trip:tr,img:await shrink(f),title:$('#mt').value.trim()||'Untitled',date:$('#md').value||today,note:$('#mn').value.trim()});if(save()){render();toast('Memory saved');if(tr){slI=2;A.openTrip(tr)}else closeSheet()}else D.mem.pop()}catch(e){toast('That photo could not be read. Try another one.')}},
  back(v){if(v){slI=2;A.openTrip(v)}else closeSheet()},
  openMem(v){const m=D.mem.find(m=>m.id===v);sheet(`<img src="${m.img}" alt="${esc(m.title)}"><h2 style="margin:0">${esc(m.title)}</h2><p class="sub">${fmt(m.date,{day:'numeric',month:'long',year:'numeric'})}</p><p style="margin:10px 0 16px">${esc(m.note)}</p><div style="display:flex;gap:10px"><button class="btn soft" data-a="back" data-v="${m.trip||''}">Close</button><button class="btn red" data-a="delMem" data-v="${m.id}">Delete</button></div>`)},
  close(){closeSheet()},
  delMem(v){const m=D.mem.find(x=>x.id===v);D.mem=D.mem.filter(x=>x.id!==v);save();render();A.back(m&&m.trip)}
};

$('#impFile').addEventListener('change',e=>{
  const f=e.target.files[0];if(!f)return;
  const r=new FileReader();
  r.onload=()=>{
    try{
      const parsed=JSON.parse(r.result);
      if(!parsed||!Array.isArray(parsed.trips))throw new Error('Invalid');
      D=Object.assign({trips:[],pack:{},rem:[],mem:[],active:null},parsed);
      save();render();toast('Backup restored');
    }catch(err){toast('Invalid backup file')}
  };
  r.readAsText(f);e.target.value='';
});

document.addEventListener('change',e=>{const i=e.target.id,v=e.target.value;if(i==='rf'&&v){sel={s:v,e:sel.e&&sel.e>=v?sel.e:null};const d=pd(v);cm={y:d.getFullYear(),m:d.getMonth()};render()}else if(i==='ru'&&v){if(!sel.s){toast('Choose the From date first');render();return}if(v<sel.s)sel={s:v,e:null};else sel.e=v;const d=pd(v);cm={y:d.getFullYear(),m:d.getMonth()};render()}});
document.addEventListener('input',e=>{
  const i=e.target.id,v=e.target.value;
  if(i==='tn')fd.n=v;else if(i==='td')fd.d=v;else if(i==='tt')fd.t=v;else if(i==='tr')fd.r=v;
  else if(i==='pkS'){pkSearch=v;render();const el=$('#pkS');if(el){el.focus();el.setSelectionRange(v.length,v.length)}}
});
document.addEventListener('click',e=>{const a=e.target.closest('[data-a]');if(a&&A[a.dataset.a]){e.stopPropagation();A[a.dataset.a](a.dataset.v,e)}});
document.addEventListener('keydown',e=>{if(e.key==='Enter'&&e.target.classList&&e.target.classList.contains('ticket'))A.pick(e.target.dataset.v)});
setInterval(()=>{let h=0;D.rem.forEach(r=>{if(!r.done&&!r.fired&&new Date(r.date+'T'+r.time)<=new Date()){r.fired=h=true;toast('Reminder: '+r.text);try{if(Notification.permission==='granted')new Notification('Wayfare',{body:r.text})}catch(e){}}});if(h){save();if(tab==='rem')render()}},20000);
render();if(!LS.g('wf_seen'))tour();
</script>
</body>
</html>
