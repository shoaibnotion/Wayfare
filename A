    const dt=addD(t.start,k),items=(t.itin&&t.itin[dt])||[],rs=D.rem.filter(r=>r.trip===v&&r.date===dt);
    if(items.length||rs.length){
      itinHtml+=`<div class="p-box"><b>Day ${k+1} · ${fmt(dt,{weekday:'short',day:'numeric',month:'short'})}</b>`+
        items.map(x=>`<div>• ${x.time?`<b>${esc(x.time)}</b> `:''}${esc(x.title)}${x.loc?` (${esc(x.loc)})`:''}</div>`).join('')+
        rs.map(r=>`<div>• [Reminder ${r.time}] ${esc(r.text)}</div>`).join('')+`</div>`;
    }
  }
  $('#printArea').innerHTML=`
    <h1>${esc(t.name)}</h1>
    <p><b>Destination:</b> ${esc(t.dest||'—')} · <b>Dates:</b> ${fmt(t.start)} to ${fmt(t.end,{day:'numeric',month:'short',year:'numeric'})} (${dur} days) · <b>Type:</b> ${esc(t.type||'—')}</p>
    ${bks.length?`<h2>Bookings & References</h2><div class="p-grid">${bks.map(b=>`<div class="p-box"><b>${esc(b.type)}: ${esc(b.title)}</b><div>Ref: <b>${esc(b.ref||'—')}</b></div><div style="font-size:11px;color:#555">${esc(b.info||'')}</div></div>`).join('')}</div>`:''}
    ${itinHtml?`<h2>Day-by-Day Schedule</h2>${itinHtml}`:''}
    <h2>Packing Checklist (${pk.filter(i=>i.done).length}/${pk.length} packed)</h2>
    <div class="p-grid">${pk.map(i=>`<div>${i.done?'☑':'☐'} ${i.q>1?i.q+'× ':''}${esc(i.t)} ${i.imp?'<b>(IMP)</b>':''} <span style="color:#666">[${i.c}]</span></div>`).join('')}</div>
    ${(t.notes||[]).length?`<h2>Trip Notes</h2>${t.notes.map(n=>`<div>• ${esc(n.text)}</div>`).join('')}`:''}
  `;
  window.print();
}

